# Copy to backend/.env for local runs or docker compose env_file
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

DATABASE_PATH=/data/db.sqlite3

SITE_BASE_URL=http://localhost

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@trumitrip.com
ADMIN_NOTIFICATION_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: run seed_data.py once on container start
SEED_DATABASE=0
